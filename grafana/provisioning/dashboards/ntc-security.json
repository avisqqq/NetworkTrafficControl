{
  "title": "NTC — Security",
  "uid": "ntc-security",
  "schemaVersion": 38,
  "refresh": "10s",
  "tags": ["ntc", "security"],
  "time": { "from": "now-1h", "to": "now" },
  "panels": [

    { "id": 1, "type": "row", "title": "Firewall Activity", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },

    {
      "id": 2, "title": "Blocked Packets (total)", "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "ntc_action_packets_total{action=\"drop\"}", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 1 }
        ]}}}
    },
    {
      "id": 3, "title": "Drop Rate %", "type": "stat",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "100 * ntc_action_packets_total{action=\"drop\"} / clamp_min(sum(ntc_action_packets_total{action=~\"pass|drop\"}), 1)", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }
        ]}}}
    },
    {
      "id": 4, "title": "Blocked Bytes (total)", "type": "stat",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "ntc_action_bytes_total{action=\"drop\"}", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "fixedColor": "red", "mode": "fixed" }}}
    },
    {
      "id": 5, "title": "SSH Bypass Events", "type": "stat",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "ntc_action_packets_total{action=\"ssh\"}", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" }}}
    },
    {
      "id": 6, "title": "Whitelist Skipped", "type": "stat",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "ntc_action_packets_total{action=\"skip\"}", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" }}}
    },
    {
      "id": 7, "title": "IPs with >20 unique ports", "type": "stat",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "count(ntc_ip_unique_dst_ports > 20) or vector(0)", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }
        ]}}}
    },

    { "id": 10, "type": "row", "title": "Blocked Traffic", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 } },

    {
      "id": 11, "title": "Blocked Packets/s — over time", "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(ntc_action_packets_total{action=\"drop\"}[1m]) * 60", "legendFormat": "Dropped pkt/s" }],
      "fieldConfig": { "defaults": { "unit": "pps", "color": { "fixedColor": "red", "mode": "fixed" },
        "custom": { "lineWidth": 2, "fillOpacity": 20 }}}
    },
    {
      "id": 12, "title": "Blocked Bytes/s — over time", "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(ntc_action_bytes_total{action=\"drop\"}[1m]) * 60", "legendFormat": "Dropped bytes/s" }],
      "fieldConfig": { "defaults": { "unit": "Bps", "color": { "fixedColor": "orange", "mode": "fixed" },
        "custom": { "lineWidth": 2, "fillOpacity": 20 }}}
    },

    { "id": 20, "type": "row", "title": "Port Scan Detection", "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 } },

    {
      "id": 21, "title": "Unique Dst Ports per IP — over time (>5)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 9 },
      "targets": [{ "expr": "ntc_ip_unique_dst_ports > 5", "legendFormat": "{{ip}}" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 1 }, "thresholds": { "mode": "absolute", "steps": [
        { "color": "yellow", "value": 5 }, { "color": "orange", "value": 15 }, { "color": "red", "value": 50 }
      ]},
      "color": { "mode": "thresholds" }}}
    },

    { "id": 30, "type": "row", "title": "SYN Flood Detection", "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 } },

    {
      "id": 31, "title": "SYN count per IP — over time", "type": "timeseries",
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 8 },
      "targets": [{ "expr": "ntc_ip_syn_count > 10", "legendFormat": "{{ip}}" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2 }, "color": { "mode": "palette-classic" }}}
    },
    {
      "id": 32, "title": "SYN / ACK ratio per IP", "type": "timeseries",
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 8 },
      "targets": [{ "expr": "ntc_ip_syn_count / clamp_min(ntc_ip_ack_count, 1)", "legendFormat": "{{ip}}" }],
      "description": "Ratio > 5 is a strong SYN flood signal (many SYN, few ACK = half-open connections)",
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "decimals": 2, "custom": { "lineWidth": 1 }, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 5 }
      ]},
      "color": { "mode": "thresholds" }}}
    },

    { "id": 40, "type": "row", "title": "Top Suspects (current window)", "gridPos": { "x": 0, "y": 33, "w": 24, "h": 1 } },

    {
      "id": 41, "title": "IPs ranked by unique ports contacted", "type": "bargauge",
      "gridPos": { "x": 0, "y": 34, "w": 12, "h": 10 },
      "targets": [{ "expr": "topk(10, ntc_ip_unique_dst_ports)", "legendFormat": "{{ip}}", "instant": true }],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-RdYlGr" }, "min": 0 }}
    },
    {
      "id": 42, "title": "IPs ranked by SYN count", "type": "bargauge",
      "gridPos": { "x": 12, "y": 34, "w": 12, "h": 10 },
      "targets": [{ "expr": "topk(10, ntc_ip_syn_count)", "legendFormat": "{{ip}}", "instant": true }],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-RdYlGr" }, "min": 0 }}
    }

  ]
}